{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scribe.local/schemas/library-v1.json",
  "title": "Scribe portable library",
  "type": "object",
  "required": ["schemaVersion", "items", "attachments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "body", "position", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "parentId": { "type": ["string", "null"], "format": "uuid" },
          "kind": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "uri": { "type": "string" },
          "tags": { "type": "string" },
          "bookmarked": { "type": "boolean" },
          "position": { "type": "integer" },
          "createdAt": { "type": "integer", "description": "Unix epoch milliseconds" },
          "updatedAt": { "type": "integer", "description": "Unix epoch milliseconds" },
          "deletedAt": { "type": ["integer", "null"], "description": "Unix epoch milliseconds" }
        },
        "additionalProperties": true
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "relativePath", "mimeType", "sha256", "size"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "relativePath": { "type": "string" },
          "mimeType": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

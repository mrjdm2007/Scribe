# Copy to .env.<your-firebase-project-id>. Do not put credentials or API keys here.
# Cloud Functions uses its attached Google service account (Application Default
# Credentials) for Gemini on Vertex AI; no Gemini API key is required.
GOOGLE_CLOUD_LOCATION=asia-south1
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
SCRIBE_AI_DAILY_LIMIT=40
